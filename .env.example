# Copy to .env and fill in. Everything here is optional — with an empty
# file the discovery layer works exactly as it does with a full one, just
# without the shared control plane.

# Optional shared control plane (a deployed worker/). It caches swarm health
# and live DHT bootstrap nodes between clients, which is what turns a ~911ms
# cold decision into ~65ms. Unset, the client behaves exactly as it does
# offline — it is an accelerator, never a dependency.
SWARMPROOF_API=

# --- Exposing the engine beyond this machine -------------------------------
# The engine is a BitTorrent client with an HTTP control API and no
# authentication. Left alone it binds 127.0.0.1, which needs no secret.
# Binding anything else is a torrent client that whoever finds the port can
# drive - they pick the content, your address joins the swarm - so it takes a
# second, explicit flag. Put a proxy in front if you need auth or rate limits.
ENGINE_HOST=127.0.0.1
ENGINE_ALLOW_PUBLIC=
ENGINE_PORT=8080
